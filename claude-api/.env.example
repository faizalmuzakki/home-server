# Claude Code API Configuration
PORT=3100

# Primary auth is the Max subscription via OAuth — run `claude` (interactive
# login) once on the host. When Claude Code hits weekly or session limits (429)
# or auth fails (401/403), the API automatically falls back to Antigravity (`agy`),
# using your Gemini subscription on the host at zero additional cost.
FALLBACK_MODEL=gemini-3.8-flash
DEFAULT_EFFORT=high

# API authentication - clients must send this as Bearer token
API_SECRET=change-me-to-a-secure-random-string

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=*

# Claude Code settings
CLAUDE_MODEL=claude-sonnet-5
MAX_TURNS=10
MAX_CONCURRENT=3
