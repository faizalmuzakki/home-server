# Immich Environment Variables

# The version of Immich to use
IMMICH_VERSION=release

# Database configuration
DB_PASSWORD=postgres
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Upload location (bound to /data/immich/photos on host)
UPLOAD_LOCATION=/data/immich/photos

# Domain name for Traefik routing
DOMAIN=example.com

# Timezone
TZ=UTC
